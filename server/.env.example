# Environment
NODE_ENV=development # Options: development, production, test

# Server Configuration (used for local dev only — Vercel ignores PORT)
PORT=4000

# Database Configuration — Supabase Postgres pooled ("Transaction" mode / pgbouncer,
# port 6543) connection string, from Project Settings -> Database in Supabase.
# Username must be "postgres.<project-ref>" (the pooler is multi-tenant and
# routes on that suffix) — copy the URI Supabase shows rather than hand-editing it.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase project URL, from Project Settings -> API in Supabase. Used to fetch
# the Auth JWKS (Project Settings -> API -> JWT Keys -> JWT Signing Keys) that
# verify the JWTs Supabase issues on sign-in (Google + email/password are both
# configured in the Supabase dashboard, not here).
SUPABASE_URL=https://your-project.supabase.co

# CORS Configuration (comma-separated if more than one origin)
CORS_ORIGIN=http://localhost:5173 # Frontend URL

# Frontend application URL (only used for the "/" health-check message)
CLIENT_URL=http://localhost:5173

# Production Only (uncomment in production)
# NODE_ENV=production
# CLIENT_URL=https://your-domain.vercel.app
# CORS_ORIGIN=https://your-domain.vercel.app

# Local Postgres, used only by the test suite (never touches the DATABASE_URL
# above) — none of these three are needed on Vercel. POSTGRES_PASSWORD is your
# local Postgres superuser password; TEST_DB_PASSWORD is a password you choose
# for the powr_test role — both are read by `npm run test:setup-db`
# (server/scripts/setup-test-db.ts), which creates that role/database.
# TEST_DB_PASSWORD must match the password in TEST_DATABASE_URL below.
# Postgres password is 'database'. Port is 5432
POSTGRES_PASSWORD=your_local_postgres_superuser_password
TEST_DB_PASSWORD=your_chosen_powr_test_role_password
TEST_DATABASE_URL=postgresql://powr_test:your_chosen_powr_test_role_password@localhost:5432/powr_test
