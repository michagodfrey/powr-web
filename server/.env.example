# Environment
NODE_ENV=development # Options: development, production, test

# Server Configuration (used for local dev only — Vercel ignores PORT)
PORT=4000

# Database Configuration — Supabase Postgres pooled ("Transaction" mode / pgbouncer,
# port 6543) connection string, from Project Settings -> Database in Supabase
DATABASE_URL=postgresql://postgres.your-project:your_password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
TEST_DATABASE_URL=postgresql://powr_test:your_password@localhost:5432/powr_test

# Supabase Auth JWT secret, from Project Settings -> API in Supabase.
# Used to verify the JWTs Supabase issues on sign-in (Google + email/password
# are both configured in the Supabase dashboard, not here).
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# CORS Configuration (comma-separated if more than one origin)
CORS_ORIGIN=http://localhost:5173 # Frontend URL

# Application URLs
CLIENT_URL=http://localhost:5173  # Frontend application URL
SERVER_URL=http://localhost:4000  # Backend API URL

# Production Only (uncomment in production)
# NODE_ENV=production
# CLIENT_URL=https://your-domain.vercel.app
# SERVER_URL=https://your-api.vercel.app
# CORS_ORIGIN=https://your-domain.vercel.app
