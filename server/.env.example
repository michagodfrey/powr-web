# Environment
NODE_ENV=development # Options: development, production, test

# Server Configuration (used for local dev only — Vercel ignores PORT)
PORT=4000

# Local dev database — a Postgres instance on your own machine, NOT the
# production Supabase database. Never point local dev at the same
# DATABASE_URL as production: this app's schema setup (`npm run setup:db`)
# DROPs and recreates every table, and running it against production wipes
# real data.
#
# POSTGRES_PASSWORD is your local Postgres superuser password. DEV_DB_PASSWORD
# is a password you choose for the powr_dev role — both are read by
# `npm run setup:dev-db` (server/scripts/setup-dev-db.ts), which creates that
# role/database. DEV_DB_PASSWORD must match the password in DATABASE_URL below.
# First-time setup: npm run setup:dev-db, then npm run setup:db.
POSTGRES_PASSWORD=your_local_postgres_superuser_password
DEV_DB_PASSWORD=your_chosen_powr_dev_role_password
DATABASE_URL=postgresql://powr_dev:your_chosen_powr_dev_role_password@localhost:5432/powr_dev

# Supabase project URL, from Project Settings -> API in Supabase. Used to fetch
# the Auth JWKS (Project Settings -> API -> JWT Keys -> JWT Signing Keys) that
# verify the JWTs Supabase issues on sign-in. Auth still goes against the real
# (production) Supabase project even in local dev — only DATABASE_URL above is
# swapped for a local database.
SUPABASE_URL=https://your-project.supabase.co

# CORS Configuration (comma-separated if more than one origin)
CORS_ORIGIN=http://localhost:5173 # Frontend URL

# Frontend application URL (only used for the "/" health-check message)
CLIENT_URL=http://localhost:5173

# Production Only — set these on the Vercel project itself, not here:
# NODE_ENV=production
# DATABASE_URL=<the Supabase pooled connection string, from Project Settings -> Database>
# CLIENT_URL=https://your-domain.vercel.app
# CORS_ORIGIN=https://your-domain.vercel.app

# Local Postgres, used only by the test suite (a third, separate database from
# both powr_dev above and production) — not needed on Vercel. TEST_DB_PASSWORD
# is a password you choose for the powr_test role, read by `npm run test:setup-db`
# (server/scripts/setup-test-db.ts), which creates that role/database.
# TEST_DB_PASSWORD must match the password in TEST_DATABASE_URL below.
TEST_DB_PASSWORD=your_chosen_powr_test_role_password
TEST_DATABASE_URL=postgresql://powr_test:your_chosen_powr_test_role_password@localhost:5432/powr_test
